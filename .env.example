# Supabase — project URL + anon/publishable key (client) and service role (server-only).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Dev-only passwordless test login. MUST stay unset/false in production —
# a public passwordless account would be a security hole. See Auth docs in the plan.
NEXT_PUBLIC_ENABLE_TEST_LOGIN=false
TEST_USER_EMAIL=test@local.dev
